    "Worked out from the pod changes Loop uploads to Nightscout. Loop records a change when the cannula is in, so times can be a few minutes later than in Loop.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnet fra pod-byttene Loop laster opp til Nightscout. Loop registrerer byttet når kanylen er satt inn, så tidene kan ligge noen minutter etter det Loop viser."
          }
        }
      }
    },
    "Worked out from the sensor start Loop uploads to Nightscout.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnet fra sensorstarten Loop laster opp til Nightscout."
