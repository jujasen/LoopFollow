      }
    },
    "No estimate: LoopFollow has no carb ratio from Loop yet. Type the bolus yourself.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke noe anslag: LoopFollow har ikke karbofaktoren fra Loop ennå. Skriv inn bolusen selv."
          }
        }
      }
    },
