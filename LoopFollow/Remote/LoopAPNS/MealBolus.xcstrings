      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi bolus"
          }
        }
      }
    },
    "Estimate. Loop works it out again when the meal arrives.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslag. Loop regner på nytt når måltidet kommer fram."
          }
        }
      }
    },
    "Fast": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskt"
          }
        }
      }
    },
