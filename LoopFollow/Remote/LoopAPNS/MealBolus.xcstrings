    "%@ g ÷ %@; Loop has no fresh recommendation to add.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ g ÷ %2$@; Loop har ingen fersk anbefaling å legge til."
