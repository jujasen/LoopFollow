      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Matvare"
          }
        }
      }
    },
    "Giving the bolus": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gir bolus"
          }
        }
      }
    },
    "Glucose": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blodsukker"
          }
        }
      }
    },
    "How fast is it absorbed?": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor fort tas det opp?"
          }
        }
      }
    },
    "If someone gives insulin after %@, Loop does not give this bolus, and you are told.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har noen gitt insulin etter %@, gir ikke Loop denne bolusen, og du får beskjed."
          }
        }
      }
    },
    "If someone gives insulin you haven't seen here, Loop does not give this bolus, and you are told.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har noen gitt insulin du ikke har sett her, gir ikke Loop denne bolusen, og du får beskjed."
          }
        }
      }
    },
    "Last bolus": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siste bolus"
          }
        }
      }
    },
    "Limited to the maximum bolus.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenset til maks bolus."
          }
        }
      }
    },
    "Loop calculated it at %@, %@ min ago": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop regnet ut kl. %1$@, for %2$@ min siden"
          }
        }
      }
    },
    "Loop did not fetch it before %@.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop hentet den ikke før %@."
          }
        }
      }
    },
    "Loop fetches it on its next run (every 5 min), or at once if the push gets through.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop henter den ved neste runde (hvert 5. min), eller med en gang hvis pushen kommer fram."
          }
        }
      }
    },
    "Loop received the command": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop mottok kommandoen"
          }
        }
      }
    },
    "Loop saves the carbs and gives %@, the amount you chose. If someone gave insulin you haven't seen here, Loop gives no bolus. You are told when the bolus is given.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop lagrer karboen og gir %@, som du valgte selv. Har noen gitt insulin du ikke har sett her, gir Loop ingen bolus. Du får beskjed når bolusen er gitt."
          }
        }
      }
    },
    "Loop saves the carbs and never gives more than %@. If insulin has come since, Loop gives less. You are told when the bolus is given.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop lagrer karboen og gir aldri mer enn %@. Har det kommet insulin siden, gir Loop mindre. Du får beskjed når bolusen er gitt."
          }
        }
      }
    },
    "Loop's prediction before the meal": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loops prognose før måltidet"
          }
        }
      }
    },
    "Loop's recommendation from %@ plus %@ g ÷ %@.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loops anbefaling fra kl. %1$@ pluss %2$@ g ÷ %3$@."
          }
        }
      }
    },
