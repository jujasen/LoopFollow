        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv måltidet"
          }
        }
      }
    },
    "AI estimate — check the numbers before you continue.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-anslag – sjekk tallene før du går videre."
          }
        }
      }
    },
    "Add or correct something…": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til eller rett noe …"
