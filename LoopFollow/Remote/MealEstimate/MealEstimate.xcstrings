{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "AI estimate — check the numbers before you continue.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-anslag – sjekk tallene før du går videre."
          }
        }
      }
    },
    "Update estimate": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdater beregning"
          }
        }
      }
    },
    "E.g. fish gratin": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. fiskegrateng"
          }
        }
      }
    },
    "Estimate carbs": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregn karbo"
          }
        }
      }
    },
    "Remove photo": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern bilde"
          }
        }
      }
    },
    "Take Photo": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bilde"
          }
        }
      }
    },
    "Choose Photos": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg bilder"
          }
        }
      }
    },
    "Add photo of the meal": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til bilde av måltidet"
          }
        }
      }
    },
    "Stop estimate": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp beregningen"
          }
        }
      }
    },
    "Hide calculation": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul utregning"
          }
        }
      }
    },
    "Show calculation": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis utregning"
          }
        }
      }
    },
    "Start over": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start på nytt"
          }
        }
      }
    },
    "Sure": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker"
          }
        }
      }
    },
    "Fairly sure": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganske sikker"
          }
        }
      }
    },
    "Unsure": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Usikker"
          }
        }
      }
    },
    "The estimate could not be read. Try again.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klarte ikke å lese beregningen. Prøv igjen."
          }
        }
      }
    },
    "Ask about carbs": {
      "comment": "Section title for the meal estimate card on the carb screen",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør om karbo"
          }
        }
      }
    },
    "Ask more or correct something…": {
      "comment": "Placeholder for adding more information to a meal estimate",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør videre eller rett noe …"
          }
        }
      }
    },
    "Only half": {
      "comment": "Quick follow-up on a meal estimate: the child ate half of it",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare halvparten"
          }
        }
      }
    },
    "Twice as much": {
      "comment": "Quick follow-up on a meal estimate: the child ate twice as much",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbelt så mye"
          }
        }
      }
    },
    "I weighed it": {
      "comment": "Quick follow-up on a meal estimate: starts a sentence giving the weight of the food",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg veide maten"
          }
        }
      }
    },
    "It weighed ": {
      "comment": "Start of the follow-up sentence giving the weight of the food, followed by the weight the caregiver types",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maten veide "
          }
        }
      }
    },
    "%@ per 100 g": {
      "comment": "Carbs per 100 g of a food in a meal estimate (1: carbs in grams)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per 100 g"
          }
        }
      }
    },
    "Saved as favorite food": {
      "comment": "Shown on a meal estimate once it has been saved as a favorite food",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret som favoritt"
          }
        }
      }
    },
    "Save as favorite – one tap next time": {
      "comment": "Button saving a meal estimate as a favorite food",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre som favoritt – ett trykk neste gang"
          }
        }
      }
    },
    "It can take up to a minute. Keep the screen open.": {
      "comment": "Shown under a meal estimate that is taking a while",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan ta opptil ett minutt. La skjermen være åpen."
          }
        }
      }
    },
    "Working out the carbs…": {
      "comment": "First line while a meal estimate is on its way",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Regner ut karboen …"
          }
        }
      }
    },
    "Looking at the photos…": {
      "comment": "Line while a meal estimate with photos takes a while",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser på bildene …"
          }
        }
      }
    },
    "Looking the food up…": {
      "comment": "Line while a meal estimate takes a while, usually because it searches the web",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søker etter maten på nettet …"
          }
        }
      }
    },
    "Type the food": {
      "comment": "Accessibility label of the empty meal estimate field, whose placeholder cycles through examples",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv maten"
          }
        }
      }
    },
    "1 Nonstop and 1 jelly man": {
      "comment": "Example in the empty meal estimate field: just the foods, no question",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1 nonstop og 1 seigmann"
          }
        }
      }
    },
    "2 wholemeal rolls": {
      "comment": "Example in the empty meal estimate field: just the foods, no question",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "2 grove rundstykker"
          }
        }
      }
    },
    "a glass of milk and a banana": {
      "comment": "Example in the empty meal estimate field: just the foods, no question",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "et glass melk og en banan"
          }
        }
      }
    },
    "carbs in a fruit pouch?": {
      "comment": "Example in the empty meal estimate field: a question",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "karbo i en klemmepose?"
          }
        }
      }
    },
    "E.g. %@": {
      "comment": "An example shown in the empty meal estimate field (1: the example)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "F.eks. %@"
          }
        }
      }
    },
    "Just type the food, ask a question or take a photo. The answer fills in the carbs below.": {
      "comment": "Explanation under the empty meal estimate card, which is above the carb fields",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv bare maten, still et spørsmål eller ta bilde. Svaret fylles inn i feltene under."
          }
        }
      }
    }
  }
}
