    "%@ changes nothing: set a target or overall insulin needs other than 100%%.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ endrer ingenting: angi et mål eller et totalt insulinbehov som ikke er 100%%."
          }
        }
      }
    },
    "%@ is above what Loop allows with these basal rates and carb ratios (%@).": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er over det Loop tillater med disse basal-satsene og karbohydratforholdene (%@)."
          }
        }
      }
    },
    "%@ is above your max carbs guardrail of %@. You can save it, but sending it will be blocked until you raise the guardrail in Remote Settings.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er over grensen din for maks karbo på %@. Du kan lagre den, men sending blokkeres til du hever grensen i fjernstyringsinnstillingene."
          }
        }
      }
    },
    "%@ is below the highest basal rate (%@).": {
      "localizations": {
        "nb": {
          "stringUnit": {
