{
  "sourceLanguage": "en",
  "strings": {
    "%1$d %% in range · %2$@ mean · %3$d lows": {
      "comment": "Insight: a period's summary (1: percent in range)(2: mean mmol/L)(3: low episodes)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d %% i mål · snitt %2$@ · %3$d følinger"
          }
        }
      }
    },
    "%1$d %% · 30 d %2$d %%": {
      "comment": "Insight: time in range last 7 and 30 days (1: 7 days)(2: 30 days)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d %% · 30 d %2$d %%"
          }
        }
      }
    },
    "%d meals": {
      "comment": "Insight: clean meals in a part of the day",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%d måltider"
          }
        }
      }
    },
    ">10 at 3 h %d %%": {
      "comment": "Insight: share of meals above 10 three hours on",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ">10 etter 3 t %d %%"
          }
        }
      }
    },
    "AI Dose Advice is off in Loop, so only the numbers are shown.": {
      "comment": "Insight: AI is off in Loop",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-doseråd er av i Loop, så bare tallene vises."
          }
        }
      }
    },
    "AI in Loop today: %1$@ calls, about $%2$@ (about %3$@ kr).": {
      "comment": "Insight: OpenAI use today in Loop (1: calls)(2: dollars)(3: kroner)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI i Loop i dag: %1$@ kall, ca. %2$@ $ (ca. %3$@ kr)."
          }
        }
      }
    },
    "Couldn't read Nightscout.": {
      "comment": "Insight tab error: the request failed",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese Nightscout."
          }
        }
      }
    },
    "From Loop %@.": {
      "comment": "Insight: when Loop last uploaded it (1: time)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra Loop kl. %@."
          }
        }
      }
    },
    "Insight": {
      "comment": "Title of the insight tab",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innsikt"
          }
        }
      }
    },
    "Last 7 days": {
      "comment": "Insight: last seven days",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siste 7 dager"
          }
        }
      }
    },
    "Loop hasn't put an insight in Nightscout yet.": {
      "comment": "Insight tab: no document in Nightscout",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop har ikke lagt innsikt i Nightscout ennå."
          }
        }
      }
    },
    "Loop is forecasting %@ mmol/L higher than usual today: less insulin is needed than usual.": {
      "comment": "Insight: today's forecast deviation, less insulin needed (1: mmol/L)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop spår %@ mmol/L for høyt i dag sammenlignet med vanlig: det trengs mindre insulin enn vanlig."
          }
        }
      }
    },
    "Loop is forecasting %@ mmol/L lower than usual today: more insulin is needed than usual.": {
      "comment": "Insight: today's forecast deviation, more insulin needed (1: mmol/L)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop spår %@ mmol/L for lavt i dag sammenlignet med vanlig: det trengs mer insulin enn vanlig."
          }
        }
      }
    },
    "Loop's forecast is about as usual today (%@ mmol/L).": {
      "comment": "Insight: today's forecast deviation is small (1: signed mmol/L)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Loops prognose treffer omtrent som vanlig i dag (%@ mmol/L)."
          }
        }
      }
    },
    "Nightscout is not set up.": {
      "comment": "Insight tab error: no Nightscout address",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightscout er ikke satt opp."
          }
        }
      }
    },
    "Nothing from Loop yet. Loop puts the insight in Nightscout, and it is read from there.": {
      "comment": "Insight tab before anything was read",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting fra Loop ennå. Loop legger innsikten i Nightscout, og den hentes derfra."
          }
        }
      }
    },
    "Numbers from Nightscout %@.": {
      "comment": "Insight: when Loop read the numbers (1: time)",
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tall fra Nightscout kl. %@."
          }
        }
      }
    },
